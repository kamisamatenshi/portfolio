[Unit]
Description=Deploy portfolio from GitHub main branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=portfolio
Group=portfolio
WorkingDirectory=/var/www/portfolio
Environment=HOME=/var/www/portfolio
Environment=NVM_DIR=/var/www/portfolio/.nvm
ExecStart=/var/www/portfolio/repo/scripts/deploy.sh
